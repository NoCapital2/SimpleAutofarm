function PcallTP(Position)
	if Player.Character then
		if Player.Character:FindFirstChild("HumanoidRootPart") then
			Player.Character.HumanoidRootPart.CFrame = Position
		end
	end
end

function PosPlayerCharacter()
	if Player.Character then
		if Player.Character:FindFirstChild("HumanoidRootPart") and Player.Character:FindFirstChildOfClass("Humanoid") then
			workspace.Gravity = 0
			Player.Character:FindFirstChildOfClass("Humanoid").PlatformStand = true
			Player.Character.HumanoidRootPart.CFrame = CFrame.new(Player.Character.HumanoidRootPart.Position.X, Player.Character.HumanoidRootPart.Position.Y, Player.Character.HumanoidRootPart.Position.Z) * CFrame.Angles(math.rad(90), 0, 0)
		end
	end
end

psobgrgr = nil
--Autofarm main
spawn(function()
	while true do
		if AutofarmEnabled and Player.Character and returncoincontaier() and not LocalPlayerDead and not FullBag then
			if psobgrgr == nil then psobgrgr = RunService.Heartbeat:Connect(PosPlayerCharacter) end
			if FindNearestCoin(returncoincontaier())[1] ~= nil then
				local dds = FindNearestCoin(returncoincontaier())
				if dds[2] > 290 then PcallTP(dds[1].CFrame); continue end
				local strg = TweenService:Create(Player.Character.HumanoidRootPart, TweenInfo.new(dds[2] / 25, Enum.EasingStyle.Linear), {CFrame = CFrame.new(dds[1].Position) * CFrame.new(0, -5, 0) * CFrame.Angles(math.rad(90), 0, 0)})
				strg:Play()
				local aww
				aww = strg.Completed:Connect(function()
					firetouchinterest(Player.Character.HumanoidRootPart, dds[1], 0)
					wait(0.01)
					firetouchinterest(Player.Character.HumanoidRootPart, dds[1], 1)
					aww:Disconnect()
				end)
				while dds[1]:FindFirstChild("TouchInterest") do
					wait()
				end
				strg:Cancel()
				wait(0.0001)
			end
		else
			if psobgrgr ~= nil then 
				psobgrgr:Disconnect() 
				psobgrgr = nil
				workspace.Gravity = 196.2
				PcallTP(FindMap()["Spawns"]:GetChildren()[math.random(1, table.maxn(FindMap()["Spawns"]:GetChildren()))].CFrame * CFrame.new(0, 3, 0))
			end
			wait(0.1)
		end
		wait(0.0001)
	end
end)

