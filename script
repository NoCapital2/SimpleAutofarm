resonfulbag = false
function ResetOnFullBag(btn)
	if not resonfulbag then
		resonfulbag = true
		btn.TextColor3 = Color3.new(0, 1, 0)
		btn.Text = "Disable"
	else
		resonfulbag = false
		btn.TextColor3 = Color3.new(1, 0, 0)
		btn.Text = "Enable"
	end
end

antilagerg = false
function AntiLagFun(btn)
	if not antilagerg then
		antilagerg = true
		btn.TextColor3 = Color3.new(0, 1, 0)
		btn.Text = "Disable"
		settings().Rendering.QualityLevel = 1
		Player.PlayerGui.MainGUI.Enabled = false
		Player.PlayerGui.MainGUI.ResetOnSpawn = false
		for _, v1 in pairs(Player.PlayerScripts:GetChildren()) do
			if v1.Name ~= "TextChatServiceClient" and v1.Name ~= "Pets" and v1.Name ~= "PetsNew" then
				v1.Enabled = false
			end
		end
	else
		antilagerg = false
		btn.TextColor3 = Color3.new(1, 0, 0)
		btn.Text = "Enable"
		Player.PlayerGui.MainGUI.Enabled = true
		Player.PlayerGui.MainGUI.ResetOnSpawn = true
		for _, v1 in pairs(Player.PlayerScripts:GetChildren()) do
			if v1.Name ~= "TextChatServiceClient" and v1.Name ~= "Pets" and v1.Name ~= "PetsNew" then
				v1.Enabled = true
			end
		end
	end
end

function FindMap()
	for _, v in pairs(workspace:GetChildren()) do
		if v:FindFirstChild("Raggy") then
			return v
		end
	end
	return false
end

RoundStarted = false
LocalPlayerDead = false
AutofarmEnabled = false
function AutoFarmButton(btn)
	if not AutofarmEnabled then
		AutofarmEnabled = true
		btn.TextColor3 = Color3.new(0, 1, 0)
		btn.Text = "Disable"
		for name, plrdata in PlayerData:InvokeServer() do
			if name == Player.Name then
				LocalPlayerDead = plrdata["Dead"]
				RoundStarted = plrdata["Dead"]
			end
		end
	else
		AutofarmEnabled = false
		btn.TextColor3 = Color3.new(1, 0, 0)
		btn.Text = "Enable"
		workspace.Gravity = 196.2
		PcallTP(FindMap()["Spawns"]:GetChildren()[math.random(1, table.maxn(FindMap()["Spawns"]:GetChildren()))].CFrame * CFrame.new(0, 3, 0))
	end
end

function returncoincontaier()
	for _, v in workspace:GetChildren() do
		if v:FindFirstChild("CoinContainer") and v:IsA("Model") then
			return v:FindFirstChild("CoinContainer")
		end
	end
	return false
end

function FindNearestCoin(container)
	local coin = nil
	local magn = math.huge
	for _, v in pairs(container:GetChildren()) do
		if v:GetAttribute("CoinID") == "Coin" and v:FindFirstChild("TouchInterest") then
			if Player.Character then
				if Player.Character:FindFirstChild("HumanoidRootPart") then
					if math.abs((Player.Character.HumanoidRootPart.Position - v.Position).Magnitude) < magn then
						coin = v
						magn = math.abs((Player.Character.HumanoidRootPart.Position - v.Position).Magnitude)
					end
				end
			end
		end
	end
	local gg = {coin, magn}
	return gg
end

